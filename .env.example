# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values. NEVER commit your .env file.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
TIME_ZONE=UTC

# Database ------------------------------------------------------------------
# Use sqlite for local development (default):
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Use MySQL in production (comment the two lines above and use these):
# DB_ENGINE=mysql
# DB_NAME=finance_db
# DB_USER=finance_user
# DB_PASSWORD=strong-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (comma separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI --------------------------------------------------------------------
# Leave empty to run with deterministic built-in fallbacks. The key is only
# ever read on the server and is never returned by any API endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT=20

# API behavior
API_PAGE_SIZE=20
THROTTLE_ANON=200/hour
THROTTLE_USER=2000/hour
SECURE_SSL_REDIRECT=True
